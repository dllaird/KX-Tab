# KX-Tab server settings. Linux: /etc/kxtab/kxtab.env (systemd EnvironmentFile).
# Windows: pass to tableau\start_tabpy.ps1 with -EnvFile. KEY=VALUE, no quotes.

# Default ticker for kxtab.history() etc. Scripts can also pass one: kxtab.history("KXNCAAF-27").
KXTAB_TICKER=KXNCAAF-27

# TabPy login file (create with: tabpy-user add -u tableau -p <password> -f <this path>)
KXTAB_PWD_FILE=/etc/kxtab/tabpy_users.txt

# TLS certificate (full chain) and private key, PEM. Must match the VM's DNS name.
KXTAB_CERT_FILE=/etc/kxtab/tls/fullchain.pem
KXTAB_KEY_FILE=/etc/kxtab/tls/privkey.pem

# Optional
# KXTAB_TABPY=/opt/KX-Tab/.venv/bin/tabpy
# KXTAB_TABPY_CONF=/opt/KX-Tab/deploy/tabpy-https.conf
# KXTAB_SERIES_STATUS=open
# KXTAB_DAILY_DAYS=400
# KXTAB_HOURLY_DAYS=8
# KXTAB_MINUTE_HOURS=0
# KXTAB_TRADES_DAYS=7
# KXTAB_MAX_MARKETS=300
# KXTAB_MAX_TRADES=200000
